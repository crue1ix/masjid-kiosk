# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit it.

# Path to the Firebase Admin SDK service account JSON you download from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Save the file in this directory as serviceAccountKey.json
# (or point this at wherever you put it).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# The mosque's WhatsApp announcements group JID. Leave this blank the very
# first time you run the bot — run `npm run list-groups` first (see
# README.md), find the right group in the printed list, then paste its id
# here and restart normally.
WHATSAPP_GROUP_JID=

# Gemini API key (free tier), from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — override the Gemini model used to parse announcements.
GEMINI_MODEL=gemini-3.6-flash

# Same Cloudinary values already used by admin.html — copy them from
# firebase-config.js's CLOUDINARY_CONFIG in the main site.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# How many days an auto-posted flyer/photo stays in the kiosk's ad reel
# before it's automatically deleted.
AD_EXPIRY_DAYS=7

# Default display duration (seconds) for auto-posted image ads.
DEFAULT_AD_DURATION_SECONDS=8

// Firestore security rules — paste into Firebase Console > Firestore Database > Rules
// (README Part 1, step 5). Kept here as the single source of truth.
//
// Admins are the Firebase Auth users that have a document at admins/{uid}
// (created by hand in the console — see README). portal.html is a public form:
// anyone can add a pending submission without signing in. Service accounts (newsletter + WhatsApp bots) bypass these
// rules entirely.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isApprovedClient() {
      return isSignedIn()
        && get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.status == 'approved';
    }

    // Admin marker docs. Users may read only their own (admin.js checks it
    // after sign-in); nobody can write them from the app.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Client accounts from the portal. A new client can only create their own
    // doc, and only as "pending"; approving/rejecting is admin-only.
    match /clients/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name', 'organization', 'email', 'phone', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // Posters/videos sent from the public form in portal.html — no sign-in
    // needed. Anyone may add a "pending" submission (field sizes capped, file
    // hosted on Cloudinary); only admins can read, change or delete them.
    match /submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['clientName', 'organization', 'email', 'phone', 'title', 'notes',
             'url', 'type', 'bytes', 'requestedStart', 'requestedEnd', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['clientName', 'email', 'title', 'url', 'type', 'status', 'createdAt'])
        && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.get('organization', '').size() <= 80
        && request.resource.data.get('notes', '').size() <= 500
        && request.resource.data.url is string
        && request.resource.data.url.matches('^https://res\.cloudinary\.com/.*')
        && request.resource.data.type in ['image', 'video'];
      allow update, delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hub_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /programs/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Holds the Gemini API key — admins only.
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }
    // "Hub opens" counter: the kiosk isn't signed in, so it may only
    // add 1 to today's count. Admins can delete days to reset it.
    match /hub_taps/{day} {
      allow read: if true;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }
  }
}
